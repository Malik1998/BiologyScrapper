# ── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# ── Admin review pages (/admin/...) ─────────────────────────────────────────
# HTTP Basic auth. Photos are real participants' faces, so the admin routes
# that can view/download them are 404 until both of these are set.
ADMIN_USER=
ADMIN_PASSWORD=

# ── Face check (optional, OFF by default - see README "Face check") ────────
# Rejects a capture if a face isn't clearly detected, so uploaders get an
# instant "please retake" instead of us finding out later. Uses OpenCV's
# bundled Haar cascade (no GPU, no model download) but it's still extra CPU
# per upload, so it defaults off in case the server is small.
# Requires: .venv/bin/pip install opencv-python-headless
ENABLE_FACE_CHECK=false

# ── Remote storage sync (optional, OFF by default) ──────────────────────────
# The full photo is always written to local disk first (data/photos/files/)
# no matter what - these only control whether a background task *also*
# mirrors it to remote storage. Leave REMOTE_STORAGE_BACKEND=none until you
# have tokens; local-only works fine on its own and nothing else needs to
# change later - just fill in the tokens below and flip this.
# One of: none | yandex_disk | s3
REMOTE_STORAGE_BACKEND=none

# --- yandex_disk backend ---
# OAuth token for a Yandex Disk app with disk.write / cloud_api:disk.write
# scope: https://yandex.ru/dev/disk/poligon/
YANDEX_DISK_TOKEN=
# Folder on the Yandex Disk where photos are mirrored (auto-created).
YANDEX_DISK_FOLDER=/annotatev2-photos

# --- s3 backend (also used for Cloudflare R2 - R2 is S3-compatible) ---
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# For real AWS S3: leave S3_ENDPOINT_URL blank and set S3_REGION (e.g. us-east-1).
# For Cloudflare R2: set S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# and S3_REGION=auto.
S3_ENDPOINT_URL=
S3_REGION=auto
